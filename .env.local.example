# Copia este archivo como .env.local y completa los valores.
# Los tres salen del dashboard de Supabase del proyecto vector-two:
#   Project Settings -> API Keys

# URL del proyecto (publica)
NEXT_PUBLIC_SUPABASE_URL=

# Llave publica. Sirve la "anon" (JWT largo) o la nueva "sb_publishable_...".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave secreta. Sirve la "service_role" (JWT largo) o la nueva "sb_secret_...".
# NUNCA la subas a GitHub ni la pongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Motor de IA (M7, propuesta con IA). Todo lo de abajo es OPCIONAL: sin estas
# variables la IA queda apagada y el resto de la aplicacion funciona igual.
# Nunca pegues la clave en un chat ni la subas al repo; en produccion va como
# variable secreta del servicio en Railway (una clave dedicada a Vector2).
# ---------------------------------------------------------------------------

# Id del adaptador del proveedor. En 0.15.0 el unico valido es "openai".
# Sin valor la IA queda apagada (no hay valor por defecto).
IA_PROVEEDOR=

# Ids de modelo que el servidor permite usar, separados por comas (el primero es
# el que proponen los formularios). Ningun id de modelo vive en el codigo.
IA_MODELO=

# Clave del proveedor (OpenAI). Solo la lee el adaptador, solo en el servidor.
OPENAI_API_KEY=

# Interruptor de emergencia: con 1 la IA se apaga sin importar lo demas.
IA_DESACTIVADA=
