# Copia este archivo como .env.local y completa los valores.
# Los tres salen del dashboard de Supabase del proyecto vector-two:
#   Project Settings -> API Keys

# URL del proyecto (publica)
NEXT_PUBLIC_SUPABASE_URL=

# Llave publica. Sirve la "anon" (JWT largo) o la nueva "sb_publishable_...".
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave secreta. Sirve la "service_role" (JWT largo) o la nueva "sb_secret_...".
# NUNCA la subas a GitHub ni la pongas en el navegador.
SUPABASE_SERVICE_ROLE_KEY=
